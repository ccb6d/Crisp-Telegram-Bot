bot:
  # Bot Token
  token: 1234:1234567890abcdef
  # 发送至群
  groupId: 0
crisp:
  # 插件 ID
  id:
  # 插件秘钥
  key:
  # 网站 ID
  website:
easyimages:
  apiUrl: "http://127.0.0.1/api/index.php"
  apiToken: "token"
autoreply:
  # 自动关键词回复，你可以复制成多行，每个关键词用 `|` 隔开即可，在 `:` 后输入自动回复内容
  "在吗|你好": "欢迎使用客服系统，请等待客服回复你~"
llm:
  # 是否启用第三方 AI/LLM 回复
  enabled: true
  # 第三方兼容 OpenAI 的接口 key
  apiKey: "dummy"
  # 第三方兼容 OpenAI 的接口地址
  baseUrl: "https://api.openai.com/v1"
  # 模型名
  model: "gpt-4o-mini"
  # 可选
  temperature: 0.4
  maxTokens: 600
  # 系统提示词
  payload: |
    你是一个简体中文在线客服。
    请始终使用纯文本回复，不要使用 Markdown。
    语气礼貌、准确、简洁，优先解决用户问题。
    回答时优先参考系统提供的知识库内容。
    如果知识库无法确认事实，请明确说明，不要编造。
knowledge_base:
  # 是否启用本地知识库
  enabled: true
  # 知识库目录，支持相对路径或绝对路径
  directory: "./knowledge"
  # 每次检索最多注入多少段知识内容
  topK: 3
