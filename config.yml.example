bot:
  # Bot Token
  token: 1234:1234567890abcdef
  # 发送至群
  groupId: 0
crisp:
  # 插件 ID
  id:
  # 插件秘钥
  key:
  # 网站 ID
  website:
easyimages:
  apiUrl: "http://127.0.0.1/api/index.php"
  apiToken: "token"
autoreply:
  # 自动关键词回复，你可以复制成多行，每个关键词用 `|` 隔开即可，在 `:` 后输入自动回复内容
  "在吗|你好": "欢迎使用客服系统，请等待客服回复你~"
llm:
  # 是否启用 AI/LLM 回复
  enabled: true
  # OpenAI-compatible API Key；如果你的 OpenClaw/代理层不校验，可随便填一个占位值
  apiKey: "dummy"
  # OpenAI-compatible Base URL
  # 示例1（官方 OpenAI）：https://api.openai.com/v1
  # 示例2（你自己的 OpenClaw/兼容代理层）：http://127.0.0.1:8787/v1
  baseUrl: "https://api.openai.com/v1"
  # 模型名；如果接的是 OpenClaw 兼容层，这里填写兼容层暴露出来的模型名
  model: "gpt-4o-mini"
  # 可选
  temperature: 0.4
  maxTokens: 600
  # 系统提示词
  payload: |
    你是一个简体中文在线客服。
    请始终使用纯文本回复，不要使用 Markdown。
    语气礼貌、准确、简洁，优先解决用户问题。
    如果用户表达不清，请先追问关键信息再继续回答。
    不要编造不存在的订单、套餐、账户状态或系统结果。
    如果你无法确认事实，请明确说明并建议转人工处理。
