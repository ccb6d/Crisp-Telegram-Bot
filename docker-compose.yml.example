name: crisp-telegram-bot

services:
  bot:
    image: ghcr.io/ccb6d/crisp-telegram-bot:latest
    restart: always
    environment:
      TZ: Asia/Shanghai
      BOT_TOKEN: 12345:abcdefghijklm
      BOT_GROUPID: -123456
      EasyImages_apiUrl: "http://127.0.0.1/api/index.php"
      EasyImages_apiToken: "token"
      CRISP_ID: aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
      CRISP_KEY: aaaaaaaaaaaaaa11111111aaaaaaaaaaaaaaaaaa
      CRISP_WEBSITE: bbbbbbbb-bbbbb-bbbb-bbbb-bbbbbbbbbbbb
      AUTOREPLY: |
        \0  '在吗|你好' : '欢迎使用客服系统，请等待客服回复你~'
        \0  '关键字1|关键字2' : '自动应答语A'
      LLM_ENABLED: true
      LLM_APIKEY: "dummy"
      LLM_BASEURL: "https://api.openai.com/v1"
      LLM_MODEL: "gpt-4o-mini"
      LLM_TEMPERATURE: 0.4
      LLM_MAXTOKENS: 600
      LLM_PAYLOAD: |
        \0    你是一个简体中文在线客服。
        \0    请始终使用纯文本回复，不要使用 Markdown。
        \0    语气礼貌、准确、简洁，优先解决用户问题。
        \0    回答时优先参考系统提供的知识库内容。
        \0    如果知识库无法确认事实，请明确说明，不要编造。
      KNOWLEDGE_BASE_ENABLED: true
      KNOWLEDGE_BASE_DIRECTORY: "./knowledge"
      KNOWLEDGE_BASE_TOPK: 3
    volumes:
      - ./knowledge:/Crisp-Telegram-Bot/knowledge:ro
